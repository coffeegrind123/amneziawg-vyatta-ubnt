priority: 650
type: txt
help: Special junk packet I4 sent before each handshake
val_help: txt; Tags: <b 0xHEX> bytes, <r N> random bytes, <rc N> random letters, <rd N> random digits, <c> counter, <t> timestamp
syntax:expression: exec "/opt/amneziawg/validate.sh ispec '$VAR(@)'"

end: /opt/amneziawg/interface.sh "$COMMIT_ACTION" "$VAR(../@)" "i4"
