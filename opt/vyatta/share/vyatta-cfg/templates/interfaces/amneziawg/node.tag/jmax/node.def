priority: 550
type: u32
help: Maximum junk packet size (Jmax)
val_help: u32:0-65535; Maximum size in bytes
syntax:expression: $VAR(@) >= 0 && $VAR(@) <= 65535; "Must be between 0-65535"

end: /opt/amneziawg/interface.sh "$COMMIT_ACTION" "$VAR(../@)" "jmax"

# Vyatta skips the interface-level check when only this node changes
commit:expression: exec "/opt/amneziawg/validate.sh interface $VAR(../@)"
