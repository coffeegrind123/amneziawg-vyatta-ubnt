priority: 700
type: txt
help: Seconds after which session keys are rejected
val_help: u32:0-65535; Seconds (0 for default 180)
val_help: <start>-<end>; Seconds (0 for default 180), a random value from the range
syntax:expression: exec "/opt/amneziawg/validate.sh range '$VAR(@)' 65535"

end: /opt/amneziawg/interface.sh "$COMMIT_ACTION" "$VAR(../@)" "reject-after-time"
