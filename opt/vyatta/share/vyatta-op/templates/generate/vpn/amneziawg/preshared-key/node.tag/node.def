help: Generate AmneziaWG preshared key with specified file name
run:
     key_path=$5

     # Prepend /config/auth if the path is not absolute
     if echo $key_path | egrep -ve '^/.*' > /dev/null; then
         full_path=/config/auth/$key_path
     else
         full_path=$key_path
     fi

     key_dir=`dirname $full_path`
     if [ ! -d $key_dir ]; then
         echo "Directory $key_dir does not exist!"
         exit 1
     fi

     echo "Generating AmneziaWG preshared key to $full_path"
     if sudo sh -c "umask 077; /usr/bin/awg genpsk > ${full_path}"; then
         echo "Your new AmneziaWG preshared key has been generated"
     fi
     /opt/vyatta/sbin/check_file_in_config_dir "$full_path" '/config/auth'
allowed: echo -n '<filename>'
